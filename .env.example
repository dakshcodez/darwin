# Copy to .env, or run `stripe projects env --pull` to generate it (values come from Stripe Projects).
# Never commit .env.

# CreateOS sandbox endpoint. We use the standard one (EU, https://api-eu.sb.createos.sh, was requested by the organizers
# but stalled often in our tests). Never mix endpoints within one run.
CREATEOS_SANDBOX_URL=https://api.sb.createos.sh        # read by the createos CLI
CREATEOS_SANDBOX_BASE_URL=https://api.sb.createos.sh   # read by the @nodeops-createos/sandbox SDK

# Written by `stripe projects add createos/project` (the SDK expects CREATEOS_SANDBOX_API_KEY;
# config.ts maps CREATEOS_PROJECT_API_KEY to it)
CREATEOS_PROJECT_API_KEY=
CREATEOS_PLAN_API_KEY=

# Written by `stripe projects add neon/postgres`
NEON_POSTGRES_CONNECTION_STRING=

# Written by `stripe projects add openrouter/api`
OPENROUTER_API_KEY=
